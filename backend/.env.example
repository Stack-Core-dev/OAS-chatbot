# Backend configuration
APP_NAME=Chatbot API
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# llama.cpp server (kept for reference)
# LLAMA_BASE_URL=http://127.0.0.1:8080
# LLAMA_MODEL=gemma-4-E2B-it-Q4_K_M
# LLAMA_TIMEOUT=300

# GenieX server
GENIEX_BASE_URL=http://127.0.0.1:18181
GENIEX_MODEL=local/gemma-4-e2b-q4_0:Q4_0
GENIEX_TIMEOUT=300

# Number of document chunks injected per question
RAG_TOP_K=3

# Management dashboard (/admin)
ADMIN_PASSWORD=change-this-password
# Optional; defaults to a secret derived from ADMIN_PASSWORD
# ADMIN_SESSION_SECRET=replace-with-a-long-random-value
ADMIN_SESSION_HOURS=12
# ADMIN_DB_PATH=admin.db
